# Copy to `scripts/.env` (gitignored). Used ONLY by the tsx ingest scripts in
# scripts/ingest/, which run on a workstation or CI box — never in the app.

SUPABASE_URL=
# Supabase dashboard > Project Settings > API > service_role.
# This key BYPASSES Row Level Security. It must never appear in .env, in the
# app bundle, or in a commit.
SUPABASE_SERVICE_ROLE_KEY=
