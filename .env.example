# Copy to `.env` and fill in. react-native-config inlines these during the
# NATIVE build — after changing a value you must rebuild (npm run ios /
# npm run android). A Metro reload will not pick it up.
#
# Everything in this file ships inside the app bundle. Treat every value here
# as public. The app holds no third-party API keys: every data source is
# reached through the backend, which keeps its own credentials.

# --- API ----------------------------------------------------------------------
# Base URL of wm-chicago-maps-backend. Every network call the app makes goes
# here (plus basemap tiles from OpenFreeMap).
#   iOS simulator:     http://localhost:3000   (shares the Mac's network)
#   Android emulator:  http://10.0.2.2:3000    (10.0.2.2 is the host Mac)
#   Physical device:   http://<your Mac's LAN IP>:3000, e.g. http://192.168.1.20:3000
#                      (find it with `ipconfig getifaddr en0`; phone and Mac on
#                      the same Wi-Fi). localhost on a phone means the phone.
API_URL=http://localhost:3000

# --- Observability (optional) ---------------------------------------------
# Sentry DSN: Sentry > Project Settings > Client Keys (DSN).
SENTRY_DSN=
# PostHog project API key: PostHog > Project Settings.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
