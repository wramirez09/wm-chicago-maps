# Copy to `.env` and fill in. react-native-config inlines these during the
# NATIVE build — after changing a value you must rebuild (npm run ios /
# npm run android). A Metro reload will not pick it up.
#
# Everything in this file ships inside the app bundle. Treat every value here
# as public. Secrets (OAuth client secrets, the Supabase service-role key) go
# in Supabase function secrets or scripts/.env instead — see the bottom.

# --- Supabase (app) -------------------------------------------------------
# Project URL and anon key: Supabase dashboard > Project Settings > API.
# The anon key is safe on-device; it is gated by Row Level Security.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- CTA ------------------------------------------------------------------
# Train Tracker key: https://www.transitchicago.com/developers/traintrackerapply/
CTA_TRAIN_KEY=
# Bus Tracker key (separate application): https://www.transitchicago.com/developers/bustracker/
CTA_BUS_KEY=

# --- Metra ----------------------------------------------------------------
# GTFS-Realtime key + secret (HTTP Basic: key = username, secret = password).
# Request at: https://metra.com/gtfs-realtime-api-key-request-license-agreement
# NOTE: the old gtfsapi.metrarail.com host was retired 1 Nov 2025; this app
# uses the current host, gtfspublic.metrarr.com.
METRA_KEY=
METRA_SECRET=

# --- Events ---------------------------------------------------------------
# Ticketmaster Discovery consumer key: https://developer-acct.ticketmaster.com/user/register
TICKETMASTER_KEY=
# Bandsintown app id: https://help.artists.bandsintown.com/en/articles/9186477-api-documentation
# (Location search may require an Amplified/partner id rather than a public one.)
BANDSINTOWN_APP_ID=

# --- Chicago / Cook County open data --------------------------------------
# Socrata app token: https://data.cityofchicago.org/profile/edit/developer_settings
# Optional. Not a secret — it is a public throttling identifier. Without it,
# requests share a stricter anonymous rate limit.
SOCRATA_APP_TOKEN=

# --- Self-hosted services -------------------------------------------------
# Photon geocoder base URL, no trailing slash: https://github.com/komoot/photon
PHOTON_URL=
# Valhalla routing base URL, no trailing slash: https://valhalla.github.io/valhalla/
VALHALLA_URL=

# --- Observability (optional) ---------------------------------------------
# Sentry DSN: Sentry > Project Settings > Client Keys (DSN).
SENTRY_DSN=
# PostHog project API key: PostHog > Project Settings.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ==========================================================================
# NOT IN THIS FILE — these must never reach the app bundle:
#
#   EVENTBRITE_TOKEN                 supabase secrets set EVENTBRITE_TOKEN=...
#   GBP_CLIENT_ID / GBP_CLIENT_SECRET / GBP_REDIRECT_URI
#                                    supabase secrets set GBP_CLIENT_ID=... etc.
#   SUPABASE_SERVICE_ROLE_KEY        scripts/.env (gitignored) — ingest only.
#                                    Bypasses RLS entirely.
# ==========================================================================
